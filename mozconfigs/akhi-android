# AkhiBrowser for Android (Fenix with GeckoView).
# Use with: MOZCONFIG=mozconfigs/akhi-android ./mach build
# then: ./mach gradle :fenix:assembleDebug

ac_add_options --enable-project=mobile/android
ac_add_options --target=aarch64-linux-android

# Front-end only work: uncomment to download prebuilt binaries instead of compiling C++/Rust.
# ac_add_options --enable-artifact-builds

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-akhi-android
