# AkhiBrowser for Windows on ARM (Snapdragon laptops), release build, made on an x64 Windows PC.
# Use with: MOZCONFIG=browser/branding/akhi/mozconfigs/akhi-windows-arm64 ./mach build && ./mach package

ac_add_options --enable-project=browser
ac_add_options --target=aarch64-pc-windows-msvc
ac_add_options --with-branding=browser/branding/akhi
ac_add_options --with-app-basename=AkhiBrowser
# No Mozilla update server or crash report server: AkhiBrowser isn't a Mozilla product
# Updates come from the GitHub releases, signed with AkhiBrowser's key: see tools/make_update.py
ac_add_options --enable-updater
ac_add_options --disable-maintenance-service
ac_add_options --disable-bits-download
export MAR_CHANNEL_ID=akhibrowser-release
export ACCEPTED_MAR_CHANNEL_IDS=akhibrowser-release
ac_add_options --disable-crashreporter

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-akhi-windows-arm64
