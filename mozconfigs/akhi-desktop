# AkhiBrowser desktop (Windows, macOS, Linux).
# Use with: MOZCONFIG=browser/branding/akhi/mozconfigs/akhi-desktop ./mach build

ac_add_options --enable-project=browser
ac_add_options --with-branding=browser/branding/akhi
ac_add_options --with-app-basename=AkhiBrowser
# No Mozilla update server or crash report server: AkhiBrowser isn't a Mozilla product
ac_add_options --disable-updater
ac_add_options --disable-crashreporter

# Front-end only work: uncomment to download prebuilt binaries instead of compiling C++/Rust.
# ac_add_options --enable-artifact-builds

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-akhi-desktop
