# AkhiBrowser for Android, 32-bit ARM phones (older and budget phones), release build.
# Use with: MOZCONFIG=mozconfigs/akhi-android-arm ./mach build && ./mach gradle :fenix:assembleRelease

ac_add_options --enable-project=mobile/android
ac_add_options --target=arm-linux-androideabi
ac_add_options --disable-crashreporter

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-akhi-android-arm
